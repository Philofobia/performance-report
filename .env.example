# Google AI API key (free tier) — used for embeddings (text-embedding-004) and LLM analysis.
# Copy this file to .env and fill it in. NEVER commit .env (it is gitignored).
GOOGLE_API_KEY=

# --- Optional: custom request headers (see docs/CUSTOM_HEADERS.md) ---
# Only needed for targets behind a bot filter. Leave blank/absent unless a
# config/targets.yaml `headers:` block references the variable; campaigns that
# do not use headers never read it.
#
# Akamai bot-allowlist token for oakley.com.
AKAMAI_BOT_TOKEN=
