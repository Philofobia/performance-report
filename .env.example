# Google AI API key (free tier) — used for embeddings (text-embedding-004) and LLM analysis.
# Copy this file to .env and fill it in. NEVER commit .env (it is gitignored).
GOOGLE_API_KEY=

# --- Optional: custom request headers (see docs/CUSTOM_HEADERS.md) ---
# Only needed for targets behind a bot filter. Leave blank/absent unless a
# config/targets.yaml `headers:` block references the variable; campaigns that
# do not use headers never read it.
#
# Akamai bot-allowlist token for oakley.com.
AKAMAI_BOT_TOKEN=

# --- Grafana field (RUM) ingestion — see docs/superpowers/specs/2026-08-24-* ---
# Only needed for `python -m cli ingest field`. Unset means the stage is not
# configured; analysis still runs and the report's field section says so.
#
# Grafana instance. Must be a public https URL — normalize/url_safety.py
# applies to it unchanged.
GRAFANA_BASE_URL=
# Service-account token with Viewer rights on the ClickHouse datasource.
GRAFANA_TOKEN=
# ClickHouse datasource uid, from the dashboard JSON.
GRAFANA_DATASOURCE_UID=
# Fully-qualified table the panels read, e.g. <tenant>.mpulse
GRAFANA_TABLE=
